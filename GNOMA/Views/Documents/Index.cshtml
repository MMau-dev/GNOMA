
@model IReadOnlyList<GNOMA.Models.Documents.DocumentDto>

@{
    ViewData["Title"] = "Mis documentos";
}

<div class="container py-4">
    <h1>Mis documentos</h1>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success">@success</div>
    }

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger">@error</div>
    }

    <form asp-controller="Documents"
          asp-action="Upload"
          method="post"
          enctype="multipart/form-data"
          class="mb-4">

        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label for="file" class="form-label">
                Seleccionar documento (PDF, PNG o JPG; máximo 10 MB)
            </label>
            <input id="file"
                   name="file"
                   type="file"
                   class="form-control"
                   accept=".pdf,.png,.jpg,.jpeg"
                   required />
        </div>

        <button type="submit" class="btn btn-primary">
            Subir documento
        </button>
    </form>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Fecha de creación</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var document in Model)
        {
            <tr>
                <td>@document.Name</td>
                <td>@document.CreatedAt.ToLocalTime().ToString("g")</td>
            </tr>
        }
        </tbody>
    </table>
</div>